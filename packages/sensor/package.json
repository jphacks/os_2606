{
  "name": "@os/sensor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests && pnpm test:ir",
    "test:ir": "tsc -b && tsc -p tsconfig.test.json && node --import tsx --experimental-test-module-mocks --test test/*.test.ts"
  },
  "dependencies": {
    "@os/api": "workspace:*",
    "@os/core": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "license": "LGPL-2.1-only"
}
