# LINE Botを起動する場合は、LINE Developersの認証情報を設定してください。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
# 外気温（℃）と相対湿度（%）。起動時の値を固定して使用します。
OUTDOOR_TEMPERATURE=
OUTDOOR_HUMIDITY=
COMFORT_TEMPERATURE=24

# 以下は変更する場合だけ編集してください。
PORT=3000
# GPIOは物理ピン番号ではなくBCM番号です。
IR_RX_GPIO=17
IR_TX_GPIO=18
DHT_GPIO=4
# 学習データの保存先。起動時も同じファイルを読み込みます。
IR_REMOTE_PATH=data/ir/remote.json

# 家の設定（house_config）を保存する JSON ファイルのパス。未指定なら data/house_config.json
HOUSE_CONFIG_PATH=data/house_config.json
