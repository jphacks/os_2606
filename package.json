{
  "name": "os_2606",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc -b",
    "start": "node packages/line/dist/server.js",
    "setup:rich-menu": "node packages/line/dist/setup-rich-menu.js",
    "typecheck": "tsc -b --noEmit",
    "clean": "tsc -b --clean",
    "test": "vitest run --passWithNoTests && pnpm test:ir",
    "test:watch": "vitest --passWithNoTests",
    "ir": "node packages/sensor/dist/cli.js",
    "sensor": "node packages/sensor/dist/cli.js",
    "test:ir": "pnpm --filter @os/sensor test:ir"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.26.2"
}
